# Local development. Never commit your populated .env.
ENV=development
# Production requires a stable random secret; generate using secrets.token_hex(32).
SECRET_KEY=
CREW_USERNAME=crew
CREW_PASSWORD=
CABINOPS_DB_PATH=backend/cabinops.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Optional operator-owned local catalogue and media directory (mount read-only in containers).
# CABIN_ATLAS_CATALOG_PATH=/operator/catalog.json
# CABIN_ATLAS_MEDIA_DIR=/operator/media
